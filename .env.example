# ==============================================================
# HYDRA BOT — Production Configuration (.env)
# ==============================================================
# Скопируйте в .env и заполните:
#   cp .env.example .env && nano .env
#
# Полная инструкция: deploy/DEPLOY_GUIDE.md
# ==============================================================

# ======== TELEGRAM ========
# Токен от @BotFather (API Token) — НЕ коммитить в git!
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=190421400,758800494
ADMIN_USERNAME=ваш_username

# ======== DEPLOY TARGET (anti-mixup) ========
# production | sandbox
APP_ENV=production
# Явный идентификатор инстанса (для predeploy-check и deploy-guard)
# Примеры: hydra-prod, hydra-sandbox
APP_INSTANCE=hydra-prod

# ======== WEBHOOK ========
# Публичный HTTPS-адрес сервера (домен из админки VDS)
# Пример: если домен zhurkinigor.fvds.ru — то https://zhurkinigor.fvds.ru
WEBHOOK_HOST=https://zhurkinigor.fvds.ru
WEBHOOK_PATH=/webhook/bot
WEBHOOK_PORT=8443
# Сгенерирует setup.sh или: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_run_setup_sh_or_openssl_rand_hex_32

# ======== POSTGRESQL ========
# Пароль выводится скриптом deploy/setup.sh при первом запуске
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydra_bot
DB_USER=hydra
DB_PASSWORD=CHANGE_ME_from_setup_sh_output
DB_POOL_MIN=2
DB_POOL_MAX=10

# ======== REDIS ========
REDIS_URL=redis://localhost:6379/0

# ======== YOOKASSA (Live) ========
# Shop ID: 390540012
# Secret Key: полная строка из ЛК (Настройки → Секретные ключи → Live)
YOOKASSA_SHOP_ID=390540012
YOOKASSA_SECRET_KEY=live_89296_xxxxxxxxxxxxxxxxxx
YOOKASSA_RETURN_URL=https://t.me/ваш_бот

# ======== ВНЕШНИЕ ССЫЛКИ ========
GENERATOR_BOT_URL=https://t.me/video_generator_bot
WORKSHOP_URL=https://example.com/workshop

# ======== ПРИЗЫ ========
PROMO_CODE=HYDRA50

# ======== НАСТРОЙКИ ДОЖИМА ========
FOLLOWUP_IDLE_MINUTES=5
FOLLOWUP_DAYS=5

# ======== API АДМИНКИ (Patch 2) ========
# Общий секрет для запросов от neurounit.fun/admin. Генерация: openssl rand -hex 32
ADMIN_API_SECRET=
# Секрет для webhook оплаты с сайта (POST /api/webhook/site)
SITE_WEBHOOK_SECRET=
