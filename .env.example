# ===========================================
# NEURO-UNIT BOT — КОНФИГУРАЦИЯ
# ===========================================
# Для highload (100K+ пользователей) обязательны:
# - WEBHOOK_HOST
# - REDIS_URL  
# - DATABASE_URL (PostgreSQL)
# ===========================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# Username админа для уведомлений (без @)
ADMIN_USERNAME=admin_username

# ===========================================
# WEBHOOK (ОБЯЗАТЕЛЬНО для production!)
# ===========================================
# URL вашего приложения на Amvera
# Формат: https://your-app-name.amvera.io
WEBHOOK_HOST=https://neuro-unit-bot.amvera.io

# Путь для Telegram webhook (не менять без необходимости)
WEBHOOK_PATH=/webhook/telegram

# ===========================================
# REDIS (ОБЯЗАТЕЛЬНО для горизонтального масштабирования!)
# ===========================================
# Amvera managed Redis или свой
# Формат: redis://default:password@host:6379/0
REDIS_URL=redis://default:your_password@redis-host:6379/0

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL (рекомендуется для highload)
# Amvera передаёт как DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# SQLite fallback (только для разработки!)
# DATABASE_PATH=/data/bot.db

# ===========================================
# YooKassa (для промо-акции)
# ===========================================
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_your_secret_key_here
YOOKASSA_RETURN_URL=https://t.me/your_bot

# Количество мест для промо (по умолчанию 5)
PROMO_SLOTS_TOTAL=5

# ===========================================
# ПРОЧЕЕ
# ===========================================
# GENERATOR_BOT_URL=https://t.me/video_generator_bot
# WORKSHOP_URL=https://example.com/workshop
