# ==============================================================
# HYDRA BOT — Sandbox Configuration (.env)
# ==============================================================
# Copy to .env on sandbox clone and fill values.
# This file is intentionally separated from production defaults.
# ==============================================================

# ======== TELEGRAM ========
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=190421400,758800494
ADMIN_USERNAME=your_username

# ======== DEPLOY TARGET (anti-mixup) ========
APP_ENV=sandbox
APP_INSTANCE=hydra-sandbox

# ======== WEBHOOK ========
WEBHOOK_HOST=https://bot-sandbox.neurounit.fun
WEBHOOK_PATH=/webhook/bot
WEBHOOK_PORT=18443
WEBHOOK_SECRET=CHANGE_ME_32_hex

# ======== POSTGRESQL ========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydra_bot_sandbox
DB_USER=hydra
DB_PASSWORD=CHANGE_ME
DB_POOL_MIN=2
DB_POOL_MAX=10

# ======== REDIS ========
REDIS_URL=redis://localhost:6379/1

# ======== YOOKASSA (Sandbox/Test only) ========
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=test_
YOOKASSA_RETURN_URL=https://t.me/Neurounit_Sandbox_bot

# ======== LINKS ========
GENERATOR_BOT_URL=https://t.me/video_generator_bot
WORKSHOP_URL=https://example.com/workshop
PROMO_CODE=HYDRA50

# ======== FOLLOWUP ========
FOLLOWUP_IDLE_MINUTES=5
FOLLOWUP_DAYS=5

# ======== API / INTEGRATIONS ========
ADMIN_API_SECRET=CHANGE_ME_32_hex
SITE_WEBHOOK_SECRET=CHANGE_ME_32_hex
